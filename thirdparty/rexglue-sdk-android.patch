+    builder_->getBuildPoint()->addInstruction(std::move(result));
+    return result_id;
+  }
   spv::StorageClass storage_class = features_.spirv_version >= spv::Spv_1_3
                                         ? spv::StorageClassStorageBuffer
                                         : spv::StorageClassUniform;
