+  assert_not_zero(binding_count_log2);
+  uint32_t binding_address_bits = (29 - 2) - binding_count_log2;
+
+  spv::Id first_address = base_address_dwords_int;
+  if (word_offsets[0]) {
+    first_address = builder_->createBinOp(spv::OpIAdd, type_int_, first_address,
+                                          builder_->makeIntConstant(int(word_offsets[0])));
+  }
+  spv::Id binding_index =
+      builder_->createBinOp(spv::OpShiftRightLogical, type_uint_,
+                            builder_->createUnaryOp(spv::OpBitcast, type_uint_, first_address),
+                            builder_->makeUintConstant(binding_address_bits));
