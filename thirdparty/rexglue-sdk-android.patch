+void SpirvBuilder::addRelaxedPrecisionToFloatArithmetic(
+    const std::vector<std::pair<spv::Id, spv::Id>>& id_ranges) {
+  if (id_ranges.empty()) {
+    return;
+  }
+  std::vector<spv::Id> ids;
+  for (const spv::Function* function : module.getFunctions()) {
+    for (const spv::Block* block : function->getBlocks()) {
+      for (const std::unique_ptr<spv::Instruction>& instruction : block->getInstructions()) {
+        spv::Id id = instruction->getResultId();
+        if (id == spv::NoResult) {
+          continue;
+        }
+        auto range = std::upper_bound(
+            id_ranges.cbegin(), id_ranges.cend(), id,
+            [](spv::Id value, const std::pair<spv::Id, spv::Id>& r) { return value < r.first; });
+        if (range == id_ranges.cbegin() || id >= std::prev(range)->second) {
+          continue;
+        }
+        switch (instruction->getOpCode()) {
+          case spv::OpFNegate:
+          case spv::OpFAdd:
+          case spv::OpFSub:
+          case spv::OpFMul:
+          case spv::OpFDiv:
+          case spv::OpFMod:
+          case spv::OpFRem:
+          case spv::OpVectorTimesScalar:
+          case spv::OpDot:
+          case spv::OpExtInst:
+          case spv::OpSelect:
+          case spv::OpVectorShuffle:
+          case spv::OpCompositeConstruct:
+          case spv::OpCompositeExtract:
+            break;
+          default:
+            continue;
+        }
+        if (getMostBasicTypeClass(instruction->getTypeId()) == spv::OpTypeFloat) {
+          ids.push_back(id);
+        }
+      }
+    }
+  }
+  for (spv::Id id : ids) {
+    addDecoration(id, spv::DecorationRelaxedPrecision);
+  }
+}
