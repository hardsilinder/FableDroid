+namespace {
+bool RtTransferSkipped(bool src_depth, uint32_t src_fmt, bool dst_depth, uint32_t dst_fmt,
+                       uint32_t src_msaa = 0, uint32_t dst_msaa = 0) {
+  int32_t m = REXCVAR_GET(rt_transfer_skip_mask);
+  if (!m) return false;
+  if (src_depth && !dst_depth) return (m & 1) != 0;
+  if (!src_depth && dst_depth) return (m & 2) != 0;
+  if (src_fmt != dst_fmt) return (m & (src_depth ? 4 : 8)) != 0;
+  if (src_msaa != dst_msaa) return (m & (src_depth ? 16 : 32)) != 0;
+  return false;
+}
+bool IsClearQuadVertexShader(uint64_t hash) {
+  static std::string parsed_source;
+  static std::vector<uint64_t> hashes;
+  const std::string& source = REXCVAR_GET(rt_clear_quad_vs_hashes);
+  if (source != parsed_source) {
+    parsed_source = source;
+    hashes.clear();
+    size_t pos = 0;
+    while (pos < source.size()) {
+      size_t end = source.find(',', pos);
+      if (end == std::string::npos) end = source.size();
+      std::string token = source.substr(pos, end - pos);
+      if (!token.empty()) hashes.push_back(std::strtoull(token.c_str(), nullptr, 16));
+      pos = end + 1;
+    }
+  }
+  return std::find(hashes.begin(), hashes.end(), hash) != hashes.end();
+}
