+  spv::Id binding_address = builder_->createBinOp(
+      spv::OpBitwiseAnd, type_int_, first_address,
+      builder_->makeIntConstant(int((uint32_t(1) << binding_address_bits) - 1)));
+  spv::Id word_binding_addresses[4];
+  for (uint32_t i = 0; i < word_count; ++i) {
+    int32_t relative_offset = word_offsets[i] - word_offsets[0];
+    word_binding_addresses[i] =
+        relative_offset ? builder_->createBinOp(spv::OpIAdd, type_int_, binding_address,
+                                                builder_->makeIntConstant(int(relative_offset)))
+                        : binding_address;
+  }
+
+  std::unique_ptr<spv::Instruction> value_phi_ops[4];
+  spv::Id header_block_id = builder_->getBuildPoint()->getId();
+  for (uint32_t i = 0; i < word_count; ++i) {
+    value_phi_ops[i] =
+        std::make_unique<spv::Instruction>(builder_->getUniqueId(), type_uint_, spv::OpPhi);
+    // Zero if out of bounds.
+    value_phi_ops[i]->addIdOperand(const_uint_0_);
+    value_phi_ops[i]->addIdOperand(header_block_id);
+  }
+
+  SpirvBuilder::SwitchBuilder binding_switch(binding_index, spv::SelectionControlDontFlattenMask,
+                                             *builder_);
+  uint32_t binding_count = uint32_t(1) << binding_count_log2;
+  for (uint32_t b = 0; b < binding_count; ++b) {
+    binding_switch.makeBeginCase(b);
+    spv::Id loaded[4];
+    for (uint32_t i = 0; i < word_count; ++i) {
+      id_vector_temp_.clear();
+      id_vector_temp_.push_back(builder_->makeIntConstant(int(b)));
+      // The only SSBO struct member.
+      id_vector_temp_.push_back(const_int_0_);
+      id_vector_temp_.push_back(word_binding_addresses[i]);
+      loaded[i] = builder_->createLoad(
+          builder_->createAccessChain(storage_class, buffers_shared_memory_, id_vector_temp_),
+          spv::NoPrecision);
+    }
+    spv::Id case_block_id = builder_->getBuildPoint()->getId();
+    for (uint32_t i = 0; i < word_count; ++i) {
+      value_phi_ops[i]->addIdOperand(loaded[i]);
+      value_phi_ops[i]->addIdOperand(case_block_id);
+    }
+  }
+  binding_switch.makeEndSwitch();
