+  }
+  if (buffer_shared_memory_texel_ != spv::NoResult) {
+    // Preserve the storage-buffer path's out-of-range zero without relying
+    // on robust image/buffer access or fetching an unresident invalid page.
+    auto result = std::make_unique<spv::Instruction>(builder_->getUniqueId(), type_uint_, spv::OpPhi);
