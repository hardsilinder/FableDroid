diff --git a/include/rex/graphics/swap_pacing.h b/include/rex/graphics/swap_pacing.h
new file mode 100644
index 0000000..41088c2
--- /dev/null
+++ b/include/rex/graphics/swap_pacing.h
@@ -0,0 +1,34 @@
+#pragma once
+// Guest-to-command-processor swap pacing (input latency, 2026-10-28).
+// VdSwap (guest thread) and the CP's PM4_XE_SWAP handler share these counters.
+// Without a limit the guest runs whole frames ahead of the CP in the ring buffer,
+// and every queued frame adds a frame of input latency.
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+namespace rex::graphics::swap_pacing {
+
+using Clock = std::chrono::steady_clock;
+
+struct State {
+  std::atomic<uint64_t> guest_swaps{0};  // VdSwap calls
+  std::atomic<uint64_t> cp_swaps{0};     // swap packets processed by the CP
+  std::atomic<int64_t> issue_ns[64]{};   // VdSwap time per swap, by index % 64
+  std::mutex mutex;
+  std::condition_variable cv;
+};
+
+// Defined in librexruntime (xboxkrnl_video.cpp) so the GPU plugin shares the one instance;
+// an inline function-local static would be duplicated per library.
+State& Get();
+
+inline int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now().time_since_epoch())
+      .count();
+}
+
+}  // namespace rex::graphics::swap_pacing
diff --git a/include/rex/graphics/swap_timing_capture.h b/include/rex/graphics/swap_timing_capture.h
new file mode 100644
index 0000000..3497b93
--- /dev/null
+++ b/include/rex/graphics/swap_timing_capture.h
@@ -0,0 +1,81 @@
+// Bounded CPU-side diagnostics. Owned exclusively by the command worker.
+#pragma once
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <vector>
+
+namespace rex::graphics {
+class SwapTimingCapture {
+ public:
+  struct Row {
+    int64_t sample_ns, limiter_ns, issue_ns, wait_ns;
+    uint32_t wait_packets;
+    // Split of the remaining interval: worker idle waiting for guest commands,
+    // and time inside backend draw translation/recording.
+    int64_t stall_ns, draw_ns, throttle_ns;
+    uint32_t draws;
+    // Overlapping driver-call diagnostics, not disjoint frame components.
+    int64_t fence_wait_ns, fence_poll_ns;
+    uint32_t fence_waits, fence_polls;
+  };
+  static int64_t Now() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+  }
+  // One capture per command processor lifetime. Allocation precedes sample 0.
+  void Arm(int32_t count) {
+    if (armed_ || count <= 0) return;
+    armed_ = true;
+    limit_ = std::min<int32_t>(count, 18000);
+    rows_.reserve(limit_);
+  }
+  bool active() const { return armed_ && rows_.size() < limit_; }
+  void Wait(int64_t ns) {
+    if (active()) { wait_ns_ += ns; ++wait_packets_; }
+  }
+  void Stall(int64_t ns) {
+    if (active()) stall_ns_ += ns;
+  }
+  void Throttle(int64_t ns) {
+    if (active()) throttle_ns_ += ns;
+  }
+  void Draw(int64_t ns) {
+    if (active()) { draw_ns_ += ns; ++draws_; }
+  }
+  void FenceWait(int64_t ns) {
+    if (active()) { fence_wait_ns_ += ns; ++fence_waits_; }
+  }
+  void FencePoll(int64_t ns) {
+    if (active()) { fence_poll_ns_ += ns; ++fence_polls_; }
+  }
+  // Returns true exactly once, after all hot capture writes have ended.
+  bool Add(int64_t sample, int64_t limiter, int64_t issue) {
+    if (!active()) return false;
+    rows_.push_back({sample, limiter, issue, wait_ns_, wait_packets_, stall_ns_, draw_ns_, throttle_ns_, draws_,
+                     fence_wait_ns_, fence_poll_ns_, fence_waits_, fence_polls_});
+    fence_wait_ns_ = fence_poll_ns_ = 0;
+    fence_waits_ = fence_polls_ = 0;
+    wait_ns_ = 0;
+    wait_packets_ = 0;
+    stall_ns_ = 0;
+    draw_ns_ = 0;
+    throttle_ns_ = 0;
+    draws_ = 0;
+    return !active();
+  }
+  const std::vector<Row>& rows() const { return rows_; }
+ private:
+  bool armed_ = false;
+  size_t limit_ = 0;
+  int64_t wait_ns_ = 0;
+  uint32_t wait_packets_ = 0;
+  int64_t stall_ns_ = 0;
+  int64_t draw_ns_ = 0;
+  int64_t throttle_ns_ = 0;
+  uint32_t draws_ = 0;
+  int64_t fence_wait_ns_ = 0, fence_poll_ns_ = 0;
+  uint32_t fence_waits_ = 0, fence_polls_ = 0;
+  std::vector<Row> rows_;
+};
+}  // namespace rex::graphics
