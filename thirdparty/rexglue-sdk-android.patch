+namespace ui {
+
+bool AndroidNativeWindowSurface::GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const {
+  int w = 0, h = 0;
+  if (window_) {
+    w = ANativeWindow_getWidth(window_);
+    h = ANativeWindow_getHeight(window_);
+  }
+  if ((w <= 0 || h <= 0) && sdl_window_) {
+    SDL_GetWindowSizeInPixels(sdl_window_, &w, &h);
+  }
+  if (w <= 0 || h <= 0) {
+    return false;
+  }
+  width_out = uint32_t(w);
+  height_out = uint32_t(h);
+  return true;
+}
