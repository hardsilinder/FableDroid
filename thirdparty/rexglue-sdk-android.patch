+// GPUTIME: one frame per log window gets timestamps around every render pass
+// and submission; segment durations are aggregated by label.
+struct GpuTimeDiag {
+  static constexpr uint32_t kMax = 4096;
+  VkQueryPool pool = VK_NULL_HANDLE;
+  double period_ns = 0.0;
+  uint32_t valid_bits = 0;
+  bool calibration_checked = false;
+  enum class State { kIdle, kRequested, kCapturing, kPending } state = State::kIdle;
+  uint32_t count = 0;
+  std::vector<std::string> labels;
+  std::vector<uint32_t> draws, verts;
+  uint32_t cur_draws = 0, cur_verts = 0;
+  uint64_t pending_submission = 0;
+  bool scissor_active = false;
+  std::map<std::pair<uint64_t, uint64_t>, std::pair<uint32_t, uint32_t>> shader_use;
+  std::chrono::steady_clock::time_point first_swap{};
+};
+GpuTimeDiag gpu_time_diag;
+void CalibrateGpuTime(const rex::ui::vulkan::VulkanDevice& vd) {
+  auto& t = gpu_time_diag;
+  if (t.calibration_checked) return;
+  const auto& ifn = vd.vulkan_instance()->functions();
+  VkPhysicalDeviceProperties properties{};
+  ifn.vkGetPhysicalDeviceProperties(vd.physical_device(), &properties);
+  uint32_t family_count = 0;
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(vd.physical_device(), &family_count, nullptr);
+  std::vector<VkQueueFamilyProperties> families(family_count);
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(vd.physical_device(), &family_count,
+                                              families.data());
+  const auto family = vd.queue_family_graphics_compute();
+  t.period_ns = properties.limits.timestampPeriod;
+  t.valid_bits = family < family_count ? families[family].timestampValidBits : 0;
+  t.calibration_checked = true;
+  REXGPU_INFO("GPUTIME calibration: device_period_ns={} valid_bits={} queue_family={}",
+              t.period_ns, t.valid_bits, family);
+  REXGPU_INFO("GPU memory limits: storage_buffer_bytes={} texel_buffer_elements={}",
+              properties.limits.maxStorageBufferRange, properties.limits.maxTexelBufferElements);
+}
+void GpuTimeMark(rex::graphics::vulkan::DeferredCommandBuffer& cb, std::string label) {
+  GpuTimeDiag& t = gpu_time_diag;
+  if (t.state != GpuTimeDiag::State::kCapturing || t.count >= GpuTimeDiag::kMax) return;
+  if (!t.labels.empty()) {
+    t.draws.back() = t.cur_draws;
+    t.verts.back() = t.cur_verts;
+  }
+  t.cur_draws = 0;
+  t.cur_verts = 0;
+  cb.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, t.pool, t.count++);
+  t.labels.push_back(std::move(label));
+  t.draws.push_back(0);
+  t.verts.push_back(0);
+}
