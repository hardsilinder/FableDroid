+void SpirvShaderTranslator::LoadUint32sFromSharedMemory(spv::Id base_address_dwords_int,
+                                                        const int32_t* word_offsets,
+                                                        uint32_t word_count, spv::Id* words_out) {
+  if (buffer_shared_memory_texel_ != spv::NoResult) {
+    for (uint32_t i = 0; i < word_count; ++i) {
+      auto address = base_address_dwords_int;
+      if (word_offsets[i]) {
+        address = builder_->createBinOp(spv::OpIAdd, type_int_, address,
+                                        builder_->makeIntConstant(word_offsets[i]));
+      }
+      words_out[i] = LoadUint32FromSharedMemory(address);
+    }
+    return;
+  }
