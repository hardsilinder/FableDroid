+  static const auto start = std::chrono::steady_clock::now();
+  static int32_t lines = 0;
+  int32_t start_seconds = REXCVAR_GET(rt_diag_start_seconds);
+  if (start_seconds <= 0 || lines >= REXCVAR_GET(rt_diag_lines)) {
+    return false;
+  }
+  if (std::chrono::steady_clock::now() - start < std::chrono::seconds(start_seconds)) {
+    return false;
+  }
+  ++lines;
+  return true;
+}
