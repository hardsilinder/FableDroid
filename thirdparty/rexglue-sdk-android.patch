+REXCVAR_DEFINE_INT32(rt_transfer_skip_mask, 0, "GPU",
+                     "RTDIAG: skip ownership transfers (1 depth->color, 2 color->depth, "
+                     "4 depth->depth format change, 8 color->color format change, "
+                     "16 depth->depth same format MSAA change, 32 color->color same format "
+                     "MSAA change)");
