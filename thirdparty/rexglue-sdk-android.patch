+#if REX_PLATFORM_ANDROID
+namespace {
+bool LoadAndroidCustomDriver(platform::DynamicLibrary& loader) {
+  const std::string& driver_name = REXCVAR_GET(vulkan_android_custom_driver);
+  if (driver_name.empty()) {
+    return false;
+  }
+  const std::string& driver_env = REXCVAR_GET(vulkan_android_driver_env);
+  for (size_t start = 0; start < driver_env.size();) {
+    size_t end = driver_env.find(';', start);
+    if (end == std::string::npos) {
+      end = driver_env.size();
+    }
+    std::string entry = driver_env.substr(start, end - start);
+    size_t equals = entry.find('=');
+    if (equals != std::string::npos && equals != 0 &&
+        entry.compare(0, equals, "REX_STDOUT_FILE") == 0) {
+      // Driver debug output (such as IR3_SHADER_DEBUG=disasm) goes to stdout,
+      // which is discarded on Android.
+      if (std::freopen(entry.c_str() + equals + 1, "w", stdout)) {
+        std::setvbuf(stdout, nullptr, _IOLBF, 0);
+        REXLOG_INFO("Custom Vulkan driver: stdout redirected to {}", entry.c_str() + equals + 1);
+      }
+    } else if (equals != std::string::npos && equals != 0) {
+      setenv(entry.substr(0, equals).c_str(), entry.c_str() + equals + 1, 1);
+      REXLOG_INFO("Custom Vulkan driver: set {}", entry);
+    }
+    start = end + 1;
+  }
+  const char* internal_storage = SDL_GetAndroidInternalStoragePath();
+  if (!internal_storage) {
+    REXLOG_ERROR("Custom Vulkan driver: no internal storage path");
+    return false;
+  }
+  std::filesystem::path driver_dir =
+      std::filesystem::path(internal_storage) / "gpu_drivers" / driver_name;
+  // The library name comes from meta.json if present, otherwise the first .so.
+  std::string library_name;
+  {
+    std::ifstream meta(driver_dir / "meta.json");
+    std::string meta_text((std::istreambuf_iterator<char>(meta)), std::istreambuf_iterator<char>());
+    size_t key = meta_text.find("\"libraryName\"");
+    if (key != std::string::npos) {
+      size_t open = meta_text.find('"', meta_text.find(':', key) + 1);
+      size_t close = open != std::string::npos ? meta_text.find('"', open + 1) : std::string::npos;
+      if (close != std::string::npos) {
+        library_name = meta_text.substr(open + 1, close - open - 1);
+      }
+    }
+  }
+  if (library_name.empty()) {
+    std::error_code ec;
+    for (const auto& entry : std::filesystem::directory_iterator(driver_dir, ec)) {
+      if (entry.path().extension() == ".so") {
+        library_name = entry.path().filename().string();
+        break;
+      }
+    }
+  }
+  if (library_name.empty()) {
+    REXLOG_ERROR("Custom Vulkan driver: no driver library in {}", driver_dir.string());
+    return false;
+  }
+  // The hooks are in the same directory as this library.
+  Dl_info self_info = {};
+  if (!dladdr(reinterpret_cast<void*>(&LoadAndroidCustomDriver), &self_info) ||
+      !self_info.dli_fname) {
+    REXLOG_ERROR("Custom Vulkan driver: couldn't locate the native library directory");
+    return false;
+  }
+  std::string hook_dir = std::filesystem::path(self_info.dli_fname).parent_path().string() + "/";
+  std::string driver_dir_string = driver_dir.string() + "/";
+  void* handle = adrenotools_open_libvulkan(RTLD_NOW, ADRENOTOOLS_DRIVER_CUSTOM, nullptr,
+                                            hook_dir.c_str(), driver_dir_string.c_str(),
+                                            library_name.c_str(), nullptr, nullptr);
+  if (!handle) {
+    REXLOG_ERROR("Custom Vulkan driver: adrenotools failed to load {}{}", driver_dir_string,
+                 library_name);
+    return false;
+  }
+  loader.Adopt(handle);
+  REXLOG_INFO("Loaded custom Vulkan driver {}{} via libadrenotools", driver_dir_string,
+              library_name);
+  return true;
+}
+}  // namespace
