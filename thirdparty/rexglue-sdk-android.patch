diff --git a/include/rex/graphics/vulkan/timestamp.h b/include/rex/graphics/vulkan/timestamp.h
new file mode 100644
index 0000000..8eff02b
--- /dev/null
+++ b/include/rex/graphics/vulkan/timestamp.h
@@ -0,0 +1,14 @@
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics::vulkan {
+
+// Vulkan timestamp counters wrap at the queue family's timestampValidBits.
+constexpr uint64_t TimestampDelta(uint64_t first, uint64_t last, uint32_t valid_bits) {
+  if (!valid_bits || valid_bits > 64) return 0;
+  const uint64_t delta = last - first;
+  return valid_bits == 64 ? delta : delta & (UINT64_MAX >> (64 - valid_bits));
+}
+
+}  // namespace rex::graphics::vulkan
