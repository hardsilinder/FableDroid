diff --git a/src/core/fiber_android.cpp b/src/core/fiber_android.cpp
new file mode 100644
index 0000000..b05237c
--- /dev/null
+++ b/src/core/fiber_android.cpp
@@ -0,0 +1,139 @@
+/**
+ * @file        rex/core/fiber_android.cpp
+ * @brief       Android/AArch64 backend for rex::thread::Fiber
+ *
+ * Bionic does not provide getcontext/makecontext/swapcontext, so fibers swap
+ * stacks directly: the callee-saved registers (x19-x30, d8-d15) are pushed on
+ * the current stack, the stack pointer is saved, and the target's is loaded.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_ANDROID
+
+#include <rex/thread/fiber.h>
+
+#include <cassert>
+#include <cstring>
+
+#if !defined(__aarch64__)
+#error "fiber_android.cpp only supports AArch64"
+#endif
+
+extern "C" {
+// x0 = where to store the current sp, x1 = sp to resume.
+void rex_fiber_switch(void** save_sp, void* resume_sp);
+// First return target of a new fiber: calls the function in x19.
+void rex_fiber_start();
+}
+
+// Saved frame: x19..x30 (96 bytes) + d8..d15 (64 bytes).
+static constexpr size_t kFrameSize = 160;
+static constexpr size_t kFrameX19 = 0;
+static constexpr size_t kFrameX29 = 80;
+static constexpr size_t kFrameX30 = 88;
+
+asm(R"(
+    .text
+    .p2align 4
+    .globl rex_fiber_switch
+    .hidden rex_fiber_switch
+    .type rex_fiber_switch, %function
+rex_fiber_switch:
+    sub  sp, sp, #160
+    stp  x19, x20, [sp, #0]
+    stp  x21, x22, [sp, #16]
+    stp  x23, x24, [sp, #32]
+    stp  x25, x26, [sp, #48]
+    stp  x27, x28, [sp, #64]
+    stp  x29, x30, [sp, #80]
+    stp  d8,  d9,  [sp, #96]
+    stp  d10, d11, [sp, #112]
+    stp  d12, d13, [sp, #128]
+    stp  d14, d15, [sp, #144]
+    mov  x2, sp
+    str  x2, [x0]
+    mov  sp, x1
+    ldp  x19, x20, [sp, #0]
+    ldp  x21, x22, [sp, #16]
+    ldp  x23, x24, [sp, #32]
+    ldp  x25, x26, [sp, #48]
+    ldp  x27, x28, [sp, #64]
+    ldp  x29, x30, [sp, #80]
+    ldp  d8,  d9,  [sp, #96]
+    ldp  d10, d11, [sp, #112]
+    ldp  d12, d13, [sp, #128]
+    ldp  d14, d15, [sp, #144]
+    add  sp, sp, #160
+    ret
+    .size rex_fiber_switch, .-rex_fiber_switch
+
+    .p2align 4
+    .globl rex_fiber_start
+    .hidden rex_fiber_start
+    .type rex_fiber_start, %function
+rex_fiber_start:
+    mov  x29, #0
+    mov  x30, #0
+    blr  x19
+    brk  #0xf000
+    .size rex_fiber_start, .-rex_fiber_start
+)");
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+
+  uintptr_t top = reinterpret_cast<uintptr_t>(f->stack_.data()) + f->stack_.size();
+  top &= ~uintptr_t(15);
+  uint8_t* frame = reinterpret_cast<uint8_t*>(top - kFrameSize);
+  std::memset(frame, 0, kFrameSize);
+  void (*trampoline)() = &Fiber::Trampoline;
+  void (*start)() = &rex_fiber_start;
+  std::memcpy(frame + kFrameX19, &trampoline, sizeof(trampoline));
+  std::memcpy(frame + kFrameX30, &start, sizeof(start));
+  (void)kFrameX29;
+  f->sp_ = frame;
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  // tls_current_ was updated by SwitchTo before the stack switch.
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+  assert(false && "Fiber entry returned");
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_switch(&from->sp_, target->sp_);
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_ANDROID
