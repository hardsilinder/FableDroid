+  if (buffer_shared_memory_texel_ != spv::NoResult && REXCVAR_GET(spirv_texel_reads_unguarded)) {
+    // Texel buffer fetches are bounds-checked by the hardware against the view
+    // size, so an out-of-range (including negative) address returns zero
+    // without a branch. Branch-free loads can be issued back to back instead
+    // of each waiting for its result at the end of its own block.
+    const auto image = builder_->createLoad(buffer_shared_memory_texel_, spv::NoPrecision);
