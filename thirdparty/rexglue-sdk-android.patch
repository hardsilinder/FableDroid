+std::string GpuStatTopS(const std::map<std::string, uint32_t>& m) {
+  std::vector<std::pair<std::string, uint32_t>> v(m.begin(), m.end());
+  std::sort(v.begin(), v.end(), [](auto& a, auto& b) { return a.second > b.second; });
+  std::string out;
+  for (size_t i = 0; i < v.size() && i < 8; ++i) {
+    out += fmt::format(" {}x{}", v[i].first, v[i].second);
+  }
+  return out;
+}
+std::string GpuStatTop(const std::map<uint32_t, uint32_t>& m) {
+  std::vector<std::pair<uint32_t, uint32_t>> v(m.begin(), m.end());
+  std::sort(v.begin(), v.end(), [](auto& a, auto& b) { return a.second > b.second; });
