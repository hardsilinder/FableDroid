+REXCVAR_DEFINE_STRING(rt_clear_quad_vs_hashes, "", "GPU",
+                      "Comma-separated hex vertex shader ucode hashes of full-surface clear "
+                      "quads (rectangle list, depth/stencil always-write, no color). Ownership "
+                      "transfers into the depth target of such draws are skipped since every "
+                      "sample is overwritten.");
